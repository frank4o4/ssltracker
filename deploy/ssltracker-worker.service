[Unit]
Description=SSL Tracker worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ssltracker
Group=ssltracker
WorkingDirectory=/opt/ssltracker
EnvironmentFile=/etc/ssltracker.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ssltracker/.venv/bin/python manage.py ssl_worker
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
