DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-generated-secret
DJANGO_ALLOWED_HOSTS=monitor.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://monitor.example.com
DJANGO_HTTPS=0
SSLTRACKER_DB_PATH=/var/lib/ssltracker/db.sqlite3
SSL_SCAN_WORKERS=8
SSL_CONNECT_TIMEOUT=5
SSL_DOMAIN_TIMEOUT=30
SSL_DIGICERT_SYNC=0
# Optional PEM trust bundle for internal certificates:
# SSL_CA_FILE=/etc/ssltracker/ca-bundle.pem
# Required only when using Microsoft Graph expiry emails:
# MS_GRAPH_SENDER=notifications@example.com
